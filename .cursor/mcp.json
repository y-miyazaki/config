{
  "mcpServers": {
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-compressor==0.34.0",
        "--exclude-tools=delete_project",
        "--",
        "codebase-memory-mcp"
      ]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.7.3"
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch==2026.11.11"
      ]
    },
    "github": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "TOKEN=\"${GH_TOKEN:-$GITHUB_TOKEN}\"; exec uvx mcp-compressor==0.34.0 -- https://api.githubcopilot.com/mcp/ -H \"Authorization=Bearer ${env:TOKEN}\" -H \"X-MCP-Readonly=true\" --auth explicit-headers"
      ]
    }
  }
}