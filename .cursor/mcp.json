{
  "mcpServers": {
    "codebase-memory-mcp": {
      "args": [],
      "command": "codebase-memory-mcp",
      "type": "stdio"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.3.0"]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp>=1.28,<2", "mcp-server-fetch==2026.8.18"]
    },
    "github": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "TOKEN=\"${GH_TOKEN:-$GITHUB_TOKEN}\"; exec uvx mcp-compressor==0.36.0 -- https://api.githubcopilot.com/mcp/ -H \"Authorization=Bearer ${env:TOKEN}\" --auth explicit-headers"
      ]
    }
  }
}
