{
  "extends": [
    "github>y-miyazaki/config//renovate/default",
    "github>y-miyazaki/config//renovate/apm-mcp-version",
    "github>y-miyazaki/config//renovate/github-actions-tool-version",
    "github>y-miyazaki/config//renovate/pre-commit-config-tool-version"
  ],
  "description": [
    "gitIgnoredAuthors: the mise lockfile workflow (on-ci-push-mise-update-lock) commits mise.lock onto Renovate branches as github-actions[bot]. Without this, Renovate treats those branches as manually edited and stops updating them. Repo-local because consuming repositories use different bot apps."
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "description": "CustomManager: Track the pinned Claude Code CLI version of the on-loop-code-review caller (repo-local: the built-in code-review skill ships inside the CLI, so every update needs a human review)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/on-loop-code-review\\.yaml$/"],
      "matchStrings": ["agent_cli_version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"],
      "depNameTemplate": "@anthropic-ai/claude-code",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Rules: Automerge minor/patch updates for grouped CLI tools (npm: mise deps and lean-ctx are excluded: their lockfile is updated by workflow and minimumReleaseAge is not enforced)",
      "addLabels": ["automerge"],
      "automerge": true,
      "matchPackageNames": [
        "DavidAnson/markdownlint-cli2",
        "DavidAnson/markdownlint-cli2-action",
        "Songmu/ecschedule",
        "aqua:Songmu/ecschedule",
        "aqua:aquasecurity/trivy",
        "aqua:astral-sh/uv",
        "aqua:gitleaks/gitleaks",
        "aqua:golangci/golangci-lint",
        "aqua:goreleaser/goreleaser",
        "aqua:hashicorp/terraform",
        "aqua:kayac/ecspresso",
        "aqua:terraform-linters/tflint",
        "aqua:zizmorcore/zizmor",
        "aquasecurity/trivy",
        "astral-sh/setup-uv",
        "astral-sh/uv",
        "github:microsoft/apm",
        "gitleaks/gitleaks",
        "golangci/golangci-lint",
        "goreleaser/goreleaser",
        "hashicorp/terraform",
        "jdx/mise",
        "kayac/ecspresso",
        "microsoft/apm",
        "pipx:semgrep",
        "semgrep",
        "tcort/markdown-link-check",
        "terraform-linters/tflint",
        "zizmorcore/zizmor"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days",
      "platformAutomerge": true
    },
    {
      "description": "Rules: Automerge minor/patch updates for pre-commit hook versions (repo-local override of the base preset, which does not automerge)",
      "addLabels": ["automerge"],
      "automerge": true,
      "matchFileNames": [
        ".pre-commit-config.yaml",
        ".pre-commit-config-*.yaml"
      ],
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days",
      "platformAutomerge": true
    },
    {
      "description": "Rules: Self-repo pins are managed by pin_config_actions.sh, not Renovate",
      "enabled": false,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["y-miyazaki/config"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Rules: Never automerge the Claude Code CLI pin of the on-loop-code-review caller (a version change can silently change the built-in code-review skill)",
      "automerge": false,
      "matchDepNames": ["@anthropic-ai/claude-code"],
      "matchFileNames": [".github/workflows/on-loop-code-review.yaml"],
      "matchManagers": ["custom.regex"],
      "platformAutomerge": false
    }
  ]
}
